<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f5ef" />
  <title>Haven — Find your home sitter</title>
  <style>
    :root {
      --ink: #20342c;
      --muted: #6d7b72;
      --green: #315d49;
      --green-dark: #254a39;
      --lime: #d7ed9b;
      --cream: #f6f5ef;
      --white: #fff;
      --line: #e6e9df;
      --shadow: 0 16px 40px rgba(32, 52, 44, .09);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--cream); color: var(--ink); }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    a { color: inherit; }
    .wrap { width: min(1160px, calc(100% - 40px)); margin: auto; }
    header { padding: 22px 0; }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .brand { display: flex; align-items: center; gap: 10px; font-size: 21px; font-weight: 800; letter-spacing: -.7px; }
    .brand-mark { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; background: var(--green); color: white; }
    .brand-mark svg { width: 21px; }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .nav-link { color: var(--muted); text-decoration: none; font-size: 14px; }
    .button { border: 0; border-radius: 999px; padding: 12px 19px; background: var(--green); color: white; font-weight: 700; transition: .2s; }
    .button:hover { background: var(--green-dark); transform: translateY(-1px); }
    .button.light { background: white; color: var(--green); border: 1px solid var(--line); }
    .hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 45px; padding: 48px 0 57px; }
    .eyebrow { color: var(--green); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.6px; }
    h1 { font-size: clamp(42px, 6vw, 68px); line-height: 1.02; letter-spacing: -3.4px; margin: 16px 0 20px; max-width: 650px; }
    h1 span { color: var(--green); }
    .hero-copy { color: var(--muted); font-size: 17px; line-height: 1.65; max-width: 520px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 25px; }
    .trust-row { margin-top: 25px; display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 13px; }
    .avatar-stack { display: flex; }
    .avatar-stack img { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--cream); object-fit: cover; margin-right: -8px; }
    .hero-art { position: relative; min-height: 390px; border-radius: 30px; overflow: hidden; background: #dce8d2; }
    .hero-art img { width: 100%; height: 100%; min-height: 390px; object-fit: cover; display: block; }
    .hero-note { position: absolute; bottom: 20px; left: 20px; right: 20px; display: flex; align-items: center; gap: 13px; padding: 16px; border-radius: 18px; background: rgba(255,255,255,.94); box-shadow: var(--shadow); }
    .note-icon { width: 42px; height: 42px; flex: none; display: grid; place-items: center; border-radius: 14px; background: var(--lime); font-size: 21px; }
    .hero-note strong { display: block; font-size: 14px; }
    .hero-note small { color: var(--muted); }
    .search-panel { position: relative; z-index: 1; margin: -4px auto 55px; padding: 21px; background: white; border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow); }
    .search-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr auto; gap: 13px; align-items: end; }
    label { display: block; margin-bottom: 7px; color: var(--muted); font-size: 12px; font-weight: 700; }
    .field { width: 100%; border: 1px solid var(--line); border-radius: 11px; background: #fff; padding: 12px 13px; color: var(--ink); outline: none; }
    .field:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(49,93,73,.1); }
    section { padding-bottom: 65px; }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 22px; }
    h2 { margin: 8px 0 0; font-size: clamp(28px, 4vw, 38px); letter-spacing: -1.7px; }
    .result-count { color: var(--muted); font-size: 14px; }
    .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
    .chip { border: 1px solid var(--line); border-radius: 999px; background: white; padding: 9px 14px; color: var(--muted); font-size: 13px; }
    .chip.active, .chip:hover { background: var(--green); border-color: var(--green); color: white; }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .card { overflow: hidden; border: 1px solid var(--line); background: white; border-radius: 19px; transition: .2s; }
    .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .card-photo { position: relative; height: 210px; background: #e4e9dc; }
    .card-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .verified { position: absolute; top: 13px; left: 13px; background: rgba(255,255,255,.95); color: var(--green); padding: 7px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
    .card-body { padding: 17px; }
    .card-title { display: flex; justify-content: space-between; gap: 8px; align-items: start; }
    .card-title h3 { margin: 0; font-size: 18px; letter-spacing: -.4px; }
    .rating { white-space: nowrap; color: #966a16; font-size: 13px; font-weight: 700; }
    .location { color: var(--muted); font-size: 13px; margin: 6px 0 13px; }
    .bio { color: #53645a; min-height: 42px; font-size: 13px; line-height: 1.55; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0; }
    .tag { background: #f1f4ec; border-radius: 999px; padding: 6px 9px; color: #53645a; font-size: 11px; }
    .card-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 13px; }
    .price { font-size: 14px; font-weight: 800; }
    .price small { color: var(--muted); font-size: 11px; font-weight: 500; }
    .book { padding: 9px 14px; font-size: 12px; }
    .empty { display: none; text-align: center; color: var(--muted); padding: 42px 12px; grid-column: 1/-1; }
    .how { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }
    .step { padding: 22px; border-radius: 18px; background: #eaf0e4; }
    .step-number { color: var(--green); font-weight: 900; font-size: 13px; }
    .step h3 { margin: 12px 0 8px; font-size: 17px; }
    .step p { margin: 0; color: var(--muted); line-height: 1.6; font-size: 13px; }
    footer { border-top: 1px solid var(--line); padding: 25px 0; color: var(--muted); font-size: 13px; }
    .footer-row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    dialog { width: min(480px, calc(100% - 28px)); border: 0; border-radius: 22px; padding: 0; box-shadow: 0 25px 80px rgba(20,35,27,.28); }
    dialog::backdrop { background: rgba(20,35,27,.52); backdrop-filter: blur(3px); }
    .modal { padding: 25px; }
    .modal-head { display: flex; justify-content: space-between; align-items: start; gap: 15px; }
    .modal h2 { font-size: 25px; margin: 0 0 8px; }
    .close { border: 0; background: #f1f4ec; border-radius: 50%; width: 34px; height: 34px; color: var(--ink); font-size: 19px; }
    .modal-copy { color: var(--muted); font-size: 13px; line-height: 1.5; margin: 0 0 19px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-group { margin-bottom: 13px; }
    .form-group.full { grid-column: 1/-1; }
    textarea.field { min-height: 85px; resize: vertical; }
    .success { display: none; padding: 15px; margin-top: 14px; border-radius: 12px; background: #edf5e6; color: var(--green); font-size: 14px; line-height: 1.5; }
    @media (max-width: 800px) {
      .hero { grid-template-columns: 1fr; gap: 25px; padding-top: 28px; }
      .hero-art, .hero-art img { min-height: 300px; }
      .search-grid { grid-template-columns: 1fr 1fr; }
      .cards { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .wrap { width: min(100% - 28px, 1160px); }
      .nav-link { display: none; }
      h1 { letter-spacing: -2.4px; }
      .hero { padding-bottom: 38px; }
      .search-panel { margin-bottom: 42px; padding: 15px; }
      .search-grid, .cards, .how { grid-template-columns: 1fr; }
      .section-head { align-items: start; flex-direction: column; }
      .card-photo { height: 230px; }
      .form-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header class="wrap">
    <nav class="nav" aria-label="Main navigation">
      <a class="brand" href="#" aria-label="Haven home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m3 11 9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </span>
        haven
      </a>
      <div class="nav-right">
        <a class="nav-link" href="#sitters">Find a sitter</a>
        <a class="nav-link" href="#how">How it works</a>
        <button class="button" onclick="document.querySelector('#sitters').scrollIntoView({behavior:'smooth'})">Find your sitter</button>
      </div>
    </nav>
  </header>

  <main>
    <div class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <div class="eyebrow">A little peace of mind</div>
          <h1 id="hero-title">Your home, in <span>good hands.</span></h1>
          <p class="hero-copy">Find a caring, reliable home sitter to look after your place, pets and plants while you’re away. Browse local profiles and send a request in minutes.</p>
          <div class="hero-actions">
            <button class="button" onclick="document.querySelector('#sitters').scrollIntoView({behavior:'smooth'})">Explore sitters →</button>
            <a class="button light" href="#how" style="text-decoration:none">How it works</a>
          </div>
          <div class="trust-row">
            <div class="avatar-stack" aria-hidden="true">
              <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=80&h=80&fit=crop&crop=faces" alt="">
              <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=80&h=80&fit=crop&crop=faces" alt="">
              <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=80&h=80&fit=crop&crop=faces" alt="">
            </div>
            <span>Local care for the things you love</span>
          </div>
        </div>
        <div class="hero-art">
          <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1100&h=800&fit=crop" alt="A bright, welcoming home living room">
          <div class="hero-note">
            <div class="note-icon" aria-hidden="true">⌂</div>
            <div><strong>Home feels like home</strong><small>Thoughtful care, while you’re away.</small></div>
          </div>
        </div>
      </section>

      <div class="search-panel" role="search" aria-label="Search home sitters">
        <div class="search-grid">
          <div>
            <label for="location">Where do you need care?</label>
            <input id="location" class="field" placeholder="City or suburb, e.g. Cape Town">
          </div>
          <div>
            <label for="service">What do you need?</label>
            <select id="service" class="field">
              <option value="all">Any service</option>
              <option value="Home sitting">Home sitting</option>
              <option value="Pet care">Pet care</option>
              <option value="Plant care">Plant care</option>
              <option value="Daily visits">Daily visits</option>
            </select>
          </div>
          <div>
            <label for="dates">When are you away?</label>
            <input id="dates" class="field" type="text" placeholder="Choose dates" onfocus="this.type='date'" onblur="if(!this.value)this.type='text'">
          </div>
          <button class="button" id="searchBtn">Search sitters</button>
        </div>
      </div>

      <section id="sitters" aria-labelledby="sitters-title">
        <div class="section-head">
          <div><div class="eyebrow">Meet your matches</div><h2 id="sitters-title">Home sitters near you</h2></div>
          <div class="result-count" id="resultCount" aria-live="polite"></div>
        </div>
        <div class="filters" aria-label="Filter by service">
          <button class="chip active" data-filter="all">All sitters</button>
          <button class="chip" data-filter="Home sitting">Home sitting</button>
          <button class="chip" data-filter="Pet care">Pet care</button>
          <button class="chip" data-filter="Plant care">Plant care</button>
          <button class="chip" data-filter="Daily visits">Daily visits</button>
        </div>
        <div class="cards" id="cards"></div>
      </section>

      <section id="how">
        <div class="section-head"><div><div class="eyebrow">Simple from start to stay</div><h2>How Haven works</h2></div></div>
        <div class="how">
          <article class="step"><div class="step-number">01 — SEARCH</div><h3>Tell us what you need</h3><p>Choose your area and the kind of care you’re looking for, from a live-in stay to daily check-ins.</p></article>
          <article class="step"><div class="step-number">02 — CONNECT</div><h3>Get to know your sitter</h3><p>Explore sample profiles, see services and send a request with your dates and care instructions.</p></article>
          <article class="step"><div class="step-number">03 — RELAX</div><h3>Head off with confidence</h3><p>Agree the details directly with your sitter and enjoy a little more peace of mind while away.</p></article>
        </div>
      </section>
    </div>
  </main>

  <footer><div class="wrap footer-row"><span>© 2026 Haven · Home care, made simple.</span><span>Prototype only — listings and requests are demonstration content.</span></div></footer>

  <dialog id="bookingDialog">
    <div class="modal">
      <div class="modal-head">
        <div><h2>Request a booking</h2><p class="modal-copy" id="modalCopy">Tell the sitter a little about your plans.</p></div>
        <button class="close" type="button" aria-label="Close dialog" id="closeDialog">×</button>
      </div>
      <form id="bookingForm">
        <div class="form-grid">
          <div class="form-group"><label for="name">Your name</label><input class="field" id="name" required placeholder="Name"></div>
          <div class="form-group"><label for="email">Email address</label><input class="field" id="email" type="email" required placeholder="you@example.com"></div>
          <div class="form-group"><label for="startDate">Start date</label><input class="field" id="startDate" type="date" required></div>
          <div class="form-group"><label for="endDate">End date</label><input class="field" id="endDate" type="date" required></div>
          <div class="form-group full"><label for="details">Anything the sitter should know?</label><textarea class="field" id="details" placeholder="Pets, routines, home-care needs…"></textarea></div>
        </div>
        <button class="button" type="submit" style="width:100%">Send request</button>
        <div class="success" id="successMessage" role="status">Thanks! Your demo request is ready. This prototype doesn’t send it to a sitter.</div>
      </form>
    </div>
  </dialog>

  <script>
    const sitters = [
      { name:"Lerato Mokoena", area:"Cape Town, Western Cape", rating:"4.9", reviews:18, price:350, photo:"photo-1544005313-94ddf0286df2", bio:"Warm, attentive sitter who loves keeping homes and furry friends happy.", services:["Home sitting","Pet care","Plant care"], tags:["Dogs & cats","Live-in stays"], verified:true },
      { name:"James van der Merwe", area:"Johannesburg, Gauteng", rating:"5.0", reviews:12, price:400, photo:"photo-1500648767791-00dcc994a43e", bio:"Reliable home care with a green thumb and a soft spot for senior pets.", services:["Home sitting","Plant care","Daily visits"], tags:["Plant care","Daily visits"], verified:true },
      { name:"Amara Naidoo", area:"Durban, KwaZulu-Natal", rating:"4.8", reviews:9, price:320, photo:"photo-1551836022-d5d88e9218df", bio:"Friendly, detail-oriented and happy to follow your home’s usual routine.", services:["Home sitting","Pet care"], tags:["Dogs & cats","Daily visits"], verified:true },
      { name:"Thabo Jacobs", area:"Pretoria, Gauteng", rating:"4.9", reviews:15, price:380, photo:"photo-1506794778202-cad84cf45f1d", bio:"Experienced sitter offering considerate care for your home and pets.", services:["Home sitting","Pet care","Plant care","Daily visits"], tags:["Dogs & cats","Live-in stays"], verified:true },
      { name:"Chloe Petersen", area:"Stellenbosch, Western Cape", rating:"5.0", reviews:7, price:360, photo:"photo-1534528741775-53994a69daeb", bio:"Calm and caring sitter who enjoys looking after pets and leafy spaces.", services:["Pet care","Plant care","Daily visits"], tags:["Plant care","Daily visits"], verified:true },
      { name:"Sizwe Dlamini", area:"Sandton, Gauteng", rating:"4.7", reviews:11, price:340, photo:"photo-1507003211169-0a1dd7228f2d", bio:"Dependable local sitter, happy to help with check-ins or longer stays.", services:["Home sitting","Pet care","Daily visits"], tags:["Dogs & cats","Daily visits"], verified:true }
    ];

    const cards = document.getElementById("cards");
    const count = document.getElementById("resultCount");
    const locationInput = document.getElementById("location");
    const serviceSelect = document.getElementById("service");
    let activeFilter = "all";

    function render() {
      const area = locationInput.value.trim().toLowerCase();
      const service = serviceSelect.value !== "all" ? serviceSelect.value : activeFilter;
      const matches = sitters.filter(sitter =>
        (!area || sitter.area.toLowerCase().includes(area)) &&
        (service === "all" || sitter.services.includes(service))
      );
      count.textContent = `${matches.length} sitter${matches.length === 1 ? "" : "s"} to explore`;
      cards.innerHTML = matches.map(sitter => `
        <article class="card">
          <div class="card-photo">
            <img src="https://images.unsplash.com/${sitter.photo}?w=700&h=500&fit=crop&crop=faces" alt="Portrait of ${sitter.name}">
            ${sitter.verified ? '<span class="verified">✓ Profile checked</span>' : ""}
          </div>
          <div class="card-body">
            <div class="card-title"><h3>${sitter.name}</h3><span class="rating">★ ${sitter.rating} <span style="color:#879188;font-weight:500">(${sitter.reviews})</span></span></div>
            <div class="location">⌖ ${sitter.area}</div>
            <div class="bio">${sitter.bio}</div>
            <div class="tags">${sitter.services.map(s => `<span class="tag">${s}</span>`).join("")}</div>
            <div class="card-bottom"><div class="price">From R${sitter.price}<small> / day</small></div><button class="button book" data-sitter="${sitter.name}">View & request</button></div>
          </div>
        </article>`).join("") || '<div class="empty" style="display:block">No sitters match those filters yet. Try another area or service.</div>';

      cards.querySelectorAll(".book").forEach(button => button.addEventListener("click", () => {
        document.getElementById("modalCopy").textContent = `Send a booking request to ${button.dataset.sitter}. Share your dates and care details to get started.`;
        document.getElementById("successMessage").style.display = "none";
        document.getElementById("bookingForm").reset();
        document.getElementById("bookingDialog").showModal();
      }));
    }

    document.querySelectorAll(".chip").forEach(chip => chip.addEventListener("click", () => {
      document.querySelectorAll(".chip").forEach(item => item.classList.remove("active"));
      chip.classList.add("active");
      activeFilter = chip.dataset.filter;
      serviceSelect.value = "all";
      render();
    }));
    document.getElementById("searchBtn").addEventListener("click", render);
    locationInput.addEventListener("keydown", event => { if (event.key === "Enter") render(); });
    serviceSelect.addEventListener("change", render);
    document.getElementById("closeDialog").addEventListener("click", () => document.getElementById("bookingDialog").close());
    document.getElementById("bookingDialog").addEventListener("click", event => {
      if (event.target === event.currentTarget) event.currentTarget.close();
    });
    document.getElementById("bookingForm").addEventListener("submit", event => {
      event.preventDefault();
      document.getElementById("successMessage").style.display = "block";
    });
    render();
  </script>
</body>
</html>
